# Modelo das variáveis de ambiente (sem valores). Copie para .env.local e preencha.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable): vai ao navegador, só é segura com RLS ligado em todas as tabelas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (mapa e avaliações) ---
# Chave da Maps Embed API (Google Cloud > APIs e serviços > Credenciais). Ela aparece no HTML do mapa (é pública), então
# RESTRINJA a chave: "Referenciadores HTTP" = mdogao.vercel.app/* e localhost:3100/*, e "Restringir chave" = só Maps Embed API.
GOOGLE_MAPS_API_KEY=
# Place ID da loja (ex.: ChIJ...). Encontre em https://developers.google.com/maps/documentation/places/web-service/place-id
# Usado no mapa e no botão "Publicar no Google" (search.google.com/local/writereview?placeid=...)
GOOGLE_PLACE_ID=
