# Modelo das variáveis de ambiente (sem valores). Copie para .env.local e preencha.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable): vai ao navegador, só é segura com RLS ligado em todas as tabelas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
