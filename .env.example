# Modelo das variáveis de ambiente (sem valores). Copie para .env.local e preencha.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable): vai ao navegador, só é segura com RLS ligado em todas as tabelas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel: área Dev (Mapas/Google/VPS, Auditoria, regras técnicas da entrega) ---
# E-mails dos admins que veem a área Dev, separados por vírgula. Vazio = todo admin vê tudo.
ADMIN_DEV_EMAILS=

# --- Google: mapa da página de contato e avaliações ---
# Chave da Maps Embed API. Aparece no HTML do mapa (é pública): RESTRINJA por "Referenciadores HTTP" (domínios do site)
# e por API (só Maps Embed API). Enquanto GOOGLE_MAPS_ENABLED não for true, o nome antigo GOOGLE_MAPS_API_KEY também vale.
GOOGLE_MAPS_EMBED_KEY=
# Place ID da loja (ex.: ChIJ...). Encontre em https://developers.google.com/maps/documentation/places/web-service/place-id
# Usado no mapa e no botão "Publicar no Google" (search.google.com/local/writereview?placeid=...)
GOOGLE_PLACE_ID=

# --- Rastreamento self-hosted (VPS: OSRM, Nominatim, PMTiles) — ver infra/README.md ---
# Sem estas variáveis o rastreamento funciona igual, mais simples: ETA pela distância, mapa sem fundo e coordenadas
# coladas pela loja no despacho quando o cliente não marcar o pino.
# Base HTTPS do VPS de mapas (ex.: https://mapas.mdogao.com.br). Também libera essa origem na CSP (precisa de novo build).
MAPAS_URL=
# Segredo enviado ao VPS no cabeçalho X-Mapas-Token (o mesmo do infra/.env). Gere com: openssl rand -hex 32
MAPAS_TOKEN=
# Opcionais (padrão: derivados de MAPAS_URL)
# OSRM_BASE_URL=
# NOMINATIM_BASE_URL=
# MAPAS_TILES_URL=
# Segredo do job diário (Vercel Cron -> /api/cron/mapas). Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Google Maps Platform: camada OPCIONAL de qualidade (desligada por padrão) — ver docs/arquitetura-rastreamento.md ---
# Ligado, o Google calcula a rota/ETA em gatilhos (início, desvio, perto do destino, pedido do cliente) e pode servir os
# tiles do mapa por um proxy do servidor. Sempre com cota mensal rígida e fallback automático para o OSRM.
GOOGLE_MAPS_ENABLED=false
# Chave de SERVIDOR (nunca NEXT_PUBLIC_). Restrinja por API: Routes API e Map Tiles API. Se ligar o Google, o mapa da
# página de contato precisa de GOOGLE_MAPS_EMBED_KEY (esta chave nunca vai ao HTML).
GOOGLE_MAPS_API_KEY=
# Assinatura dos links do proxy de tiles do Google (mín. 32 caracteres). Sem ela o mapa Google fica desligado.
MAPAS_HMAC_SECRET=
# Cotas mensais (eventos). Ficam abaixo da cota grátis de cada SKU; 0 = Google desligado para aquele SKU.
GOOGLE_MAPS_MONTHLY_ROUTE_CAP=10000
GOOGLE_MAPS_MONTHLY_MAP_CAP=10000
GOOGLE_MAPS_MONTHLY_TILE_CAP=100000
# Recalcular rota no Google no máximo a cada N minutos; cache de rota (5 a 15 min)
GOOGLE_ROUTE_RECALC_INTERVAL_MINUTES=2
GOOGLE_ROUTE_CACHE_TTL_MINUTES=10
# Para onde cair quando o Google falhar/sem cota: osrm | estimativa
GOOGLE_MAPS_FALLBACK_PROVIDER=osrm
# Opcionais: % da cota em que passa sozinho para o OSRM (padrão 95), horário de pico "11-14,18-23" (vazio = dia todo),
# planos de restaurante com Google (padrão basico,premium), mapa Google além da rota (true/false)
# GOOGLE_MAPS_SOFT_LIMIT_PCT=95
# GOOGLE_MAPS_PEAK_HOURS=
# GOOGLE_MAPS_PLANS=basico,premium
# GOOGLE_MAPS_MAP_ENABLED=true
