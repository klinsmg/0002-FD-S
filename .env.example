# Modelo das variáveis de ambiente (sem valores). Copie para .env.local e preencha.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable): vai ao navegador, só é segura com RLS ligado em todas as tabelas
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (mapa e avaliações) ---
# Chave da Maps Embed API (Google Cloud > APIs e serviços > Credenciais). Ela aparece no HTML do mapa (é pública), então
# RESTRINJA a chave: "Referenciadores HTTP" = mdogao.vercel.app/* e localhost:3100/*, e "Restringir chave" = só Maps Embed API.
GOOGLE_MAPS_API_KEY=
# Place ID da loja (ex.: ChIJ...). Encontre em https://developers.google.com/maps/documentation/places/web-service/place-id
# Usado no mapa e no botão "Publicar no Google" (search.google.com/local/writereview?placeid=...)
GOOGLE_PLACE_ID=

# --- Rastreamento de entregas (blocos 11 e 12) ---
# DUAS chaves NOVAS, separadas da chave do mapa acima (Google Cloud > APIs e serviços > Credenciais > Criar credenciais > Chave de API).
# 1) BACKEND: SOMENTE no servidor (sem NEXT_PUBLIC_). Geocodifica o endereço do pedido e calcula rota/ETA.
#    Restrições da chave: "Restrições de aplicativo" = Nenhuma (a Vercel não tem IP fixo); "Restrições de API" = Geocoding API + Routes API.
#    Ative as duas APIs no projeto (Biblioteca de APIs). Configure um alerta de orçamento no faturamento.
GOOGLE_MAPS_SERVER_KEY=
# 2) FRONTEND: vai ao navegador (desenha o mapa ao vivo do pedido). É pública por natureza, então RESTRINJA:
#    "Referenciadores HTTP" = https://mdogao.vercel.app/* e http://localhost:3100/*; "Restrições de API" = Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
