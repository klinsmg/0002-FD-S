# Variáveis do VPS de mapas (copie para infra/.env — já ignorado pelo git — e preencha; NUNCA comite o .env).
# Domínio do VPS (registro A apontando para o IP do servidor)
MAPAS_DOMINIO=
# Segredo compartilhado com o site (o mesmo MAPAS_TOKEN da Vercel). Gere com: openssl rand -hex 32
MAPAS_TOKEN=
# Origem do site autorizada no CORS dos tiles (exatamente, sem barra no fim). Ex.: https://mdogao.vercel.app
SITE_ORIGEM=
# Senha do Postgres interno do Nominatim (não sai do servidor). Gere com: openssl rand -hex 24
NOMINATIM_DB_PASSWORD=
