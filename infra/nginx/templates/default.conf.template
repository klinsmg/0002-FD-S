# Nginx do VPS de mapas (variáveis preenchidas pelo envsubst da imagem oficial: MAPAS_DOMINIO, MAPAS_TOKEN, SITE_ORIGEM)
#   /tiles/      público, só leitura, HTTP Range (PMTiles), CORS só para o site, cache longo
#   /osrm/       rotas e map matching — exige X-Mapas-Token (só o backend do site conhece)
#   /nominatim/  endereços — exige X-Mapas-Token
# HTTPS obrigatório (HTTP só para o desafio do Let's Encrypt e redirecionar).

limit_req_zone $binary_remote_addr zone=tiles:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
map $http_x_mapas_token $token_ok { default 0; "${MAPAS_TOKEN}" 1; }
map $http_origin $cors { default ""; "${SITE_ORIGEM}" $http_origin; }

server_tokens off;

server {
  listen 80;
  server_name ${MAPAS_DOMINIO};
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${MAPAS_DOMINIO};
  ssl_certificate     /etc/letsencrypt/live/${MAPAS_DOMINIO}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${MAPAS_DOMINIO}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  client_max_body_size 4k;

  location = / { return 204; }

  # só arquivos .pmtiles da pasta de dados (o .osm.pbf e os arquivos do OSRM ficam inacessíveis)
  location ~ ^/tiles/([A-Za-z0-9_-]+\.pmtiles)$ {
    limit_req zone=tiles burst=200 nodelay;
    limit_except GET HEAD OPTIONS { deny all; }
    alias /srv/tiles/$1;
    add_header Access-Control-Allow-Origin $cors always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Range, If-Match" always;
    add_header Access-Control-Expose-Headers "Content-Length, Content-Range, ETag" always;
    add_header Vary Origin always;
    add_header Cache-Control "public, max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    if ($request_method = OPTIONS) { return 204; }
  }

  location /osrm/ {
    limit_req zone=api burst=20 nodelay;
    if ($token_ok = 0) { return 403; }
    limit_except GET { deny all; }
    proxy_pass http://osrm:5000/;
    proxy_read_timeout 10s;
  }

  location /nominatim/ {
    limit_req zone=api burst=20 nodelay;
    if ($token_ok = 0) { return 403; }
    limit_except GET { deny all; }
    proxy_pass http://nominatim:8080/;
    proxy_read_timeout 10s;
  }

  location / { return 404; }
}
